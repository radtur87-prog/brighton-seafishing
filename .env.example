# Skopíruj tento súbor do .env a doplň hodnoty z Project Settings -> API v tvojom Supabase projekte.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Používa sa iba na serverovej strane v supabase/functions/analyze-photo (Supabase Edge Function secret),
# nikdy ho nedávaj do EXPO_PUBLIC_* premenných ani do klientského kódu.
ANTHROPIC_API_KEY=sk-ant-...
